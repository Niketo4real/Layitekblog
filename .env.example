# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (automatically provided by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Supabase Environment Variables (configure in AI Studio Secrets or hosting provider)
# Note: SUPABASE_URL accepts either the base URL (https://<project-ref>.supabase.co)
# or the REST endpoint (https://<project-ref>.supabase.co/rest/v1/)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Client-side Supabase Variables (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
